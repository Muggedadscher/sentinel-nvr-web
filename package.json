{
  "name": "sentinel-nvr-web",
  "private": true,
  "description": "Shared browser packages for the Sentinel NVR plugin for Scrypted.",
  "license": "MIT",
  "author": "Muggedadscher",
  "repository": { "type": "git", "url": "https://github.com/Muggedadscher/sentinel-nvr-web.git" },
  "workspaces": ["packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "npm run build --workspaces --if-present",

{
  "name": "@sentinel-nvr/web",
  "version": "0.11.0",
  "description": "Shared browser code for the Sentinel NVR plugin for Scrypted: API model + client (/api), player (/player) and React UI with i18n + themes (/ui). Consumed by the plugin's own web UI and the HAPulse dashboard.",
  "license": "MIT",
  "author": "Muggedadscher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muggedadscher/sentinel-nvr-web.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "NOTICE.md"
  ],
  "exports": {
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js",
      "default": "./dist/api/index.js"
    },
    "./player": {
      "types": "./dist/player/index.d.ts",
      "import": "./dist/player/index.js",
      "default": "./dist/player/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    },
    "./ui/ui.css": "./dist/ui/ui.css",
    "./ui/locales/*": "./dist/ui/locales/*"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && mkdir -p dist/ui && cp src/ui/ui.css dist/ui/ui.css && rm -rf dist/ui/locales && cp -r src/ui/locales dist/ui/locales",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:tz": "TZ=UTC vitest run && TZ=Europe/Berlin vitest run && TZ=America/New_York vitest run",
    "prepublishOnly": "node scripts/prepublish-check.mjs && npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "lucide-react": "^0.469.0",
    "prettier": "^3.9.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  }
}
